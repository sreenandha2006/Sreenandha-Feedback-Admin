# Environment variables template for Sreenandha Feedback Admin Backend
PORT=5000
# For local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/sreenandha_feedback
# For MongoDB Atlas (replace <username>, <password>, and <cluster-url>):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/sreenandha_feedback?retryWrites=true&w=majority
